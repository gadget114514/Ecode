#include <windows.h>
#include "../include/resource.h"

IDI_APP_ICON ICON "..\\images\\appicon.ico"
#include "generated/icons.rc"

IDD_SETTINGS DIALOGEX 0, 0, 300, 350

STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ecode Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_TAB_SETTINGS,"SysTabControl32",WS_TABSTOP,5,5,290,300
    DEFPUSHBUTTON   "OK",IDOK,180,320,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,235,320,50,14
END

IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 290, 290
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Font Family:",IDC_STATIC,10,10,60,12
    EDITTEXT        IDC_FONT_FAMILY,72,8,120,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Font...",IDC_FONT_BROWSE,196,8,40,14
    
    LTEXT           "Font Size:",IDC_STATIC,10,30,55,12
    EDITTEXT        IDC_FONT_SIZE,65,28,50,14,ES_AUTOHSCROLL | ES_NUMBER
    
    LTEXT           "Font Weight:",IDC_STATIC,120,30,60,12
    EDITTEXT        IDC_FONT_WEIGHT,180,28,50,14,ES_AUTOHSCROLL | ES_NUMBER
    
    CHECKBOX        "Show Line Numbers",IDC_SHOW_LINE_NUMBERS,10,50,140,12
    CHECKBOX        "Enable Ligatures",IDC_ENABLE_LIGATURES,160,50,120,12
    CHECKBOX        "Enable Word Wrap",IDC_WORD_WRAP,10,68,140,12
    
    LTEXT           "Wrap Width (0 for auto):",IDC_STATIC,10,88,110,12
    EDITTEXT        IDC_WRAP_WIDTH,120,86,40,14,ES_AUTOHSCROLL | ES_NUMBER
    
    LTEXT           "Language:",IDC_STATIC,10,108,60,12
    COMBOBOX        IDC_LANGUAGE,70,105,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Caret Style:",IDC_STATIC,10,128,60,12
    COMBOBOX        IDC_CARET_STYLE,70,125,80,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "Caret Blinking",IDC_CARET_BLINKING,160,128,90,12
    
    LTEXT           "Log Level:",IDC_STATIC,10,148,60,12
    COMBOBOX        IDC_LOG_LEVEL,70,145,80,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "VT Debug",IDC_VT_DEBUG,70,167,80,12

    LTEXT           "Bash Path:",IDC_STATIC,10,185,60,12
    EDITTEXT        IDC_BASH_PATH,70,183,130,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BASH_BROWSE,205,183,20,14

    LTEXT           "Text Editor Default Extension:",IDC_STATIC,10,205,130,12
    EDITTEXT        IDC_DEFAULT_EXT,130,203,90,14,ES_AUTOHSCROLL

    AUTOCHECKBOX    "Hide Title Bar (requires restart)",IDC_NO_TITLE_BAR,10,222,190,12
    AUTOCHECKBOX    "Reverse Scroll Direction",IDC_REVERSE_SCROLL_DIRECTION,10,238,150,12
    AUTOCHECKBOX    "Hide *Messages* Buffer",IDC_HIDE_MESSAGES_BUFFER,10,252,150,12
    
    LTEXT           "Plugins Directory:",IDC_STATIC,10,270,90,12
    EDITTEXT        IDC_PLUGINS_DIR,100,254,120,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_PLUGINS_BROWSE,225,254,20,14
END

IDD_SETTINGS_AI DIALOGEX 0, 0, 250, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Active Server:",IDC_STATIC,10,10,60,12
    COMBOBOX        IDC_AI_SERVER,70,8,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    GROUPBOX        "Server Configuration",IDC_STATIC,5,30,240,140
    
    LTEXT           "Model Name:",IDC_STATIC,15,45,55,12
    EDITTEXT        IDC_AI_MODEL,75,43,120,14,ES_AUTOHSCROLL
    
    LTEXT           "API Base URL:",IDC_STATIC,15,65,55,12
    EDITTEXT        IDC_AI_BASE_URL,75,63,155,14,ES_AUTOHSCROLL
    
    LTEXT           "API Key:",IDC_STATIC,15,85,55,12
    EDITTEXT        IDC_AI_KEY,75,83,155,14,ES_PASSWORD | ES_AUTOHSCROLL
    
    LTEXT           "Allowed Project Directory:",IDC_STATIC,15,105,110,12
    EDITTEXT        IDC_AI_PROJECT_DIR,125,103,100,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_AI_PROJECT_DIR_BROWSE,230,103,20,14
    
    LTEXT           "(Note: AI can only edit files within this folder if specified)",IDC_STATIC,15,128,210,16
END

IDD_JUMP_TO_LINE DIALOGEX 0, 0, 150, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jump to Line"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Line Number:",IDC_STATIC,10,15,50,8
    EDITTEXT        IDC_LINE_NUMBER,65,12,50,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Go",IDOK,40,40,30,14
    PUSHBUTTON      "Cancel",IDCANCEL,80,40,30,14
END

IDD_MACRO_GALLERY DIALOGEX 0, 0, 200, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Macro Gallery"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_MACRO_LIST,10,10,180,110,LBS_STANDARD | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Run",IDC_RUN_MACRO,10,130,50,14
    PUSHBUTTON      "Close",IDCANCEL,140,130,50,14
END

IDD_PROGRESS DIALOGEX 0, 0, 180, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "Processing..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Please wait...",IDC_PROGRESS_TEXT,10,10,160,8
    CONTROL         "",IDC_PROGRESS_BAR,"msctls_progress32",WS_CHILD | WS_VISIBLE | 0x01,10,25,160,14
END

IDD_DIRED_PAIRS DIALOGEX 0, 0, 350, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dired Directory Pairs"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
