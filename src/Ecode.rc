    LTEXT           "Left:",IDC_STATIC,5,128,30,12
    EDITTEXT        IDC_DP_LEFT,40,126,220,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DP_LEFT_BROWSE,265,126,20,14

    LTEXT           "Right:",IDC_STATIC,5,148,30,12
    EDITTEXT        IDC_DP_RIGHT,40,146,220,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DP_RIGHT_BROWSE,265,146,20,14

    PUSHBUTTON      "Add",IDC_DP_ADD,10,178,40,14
    PUSHBUTTON      "Duplicate",IDC_DP_DUPLICATE,55,178,50,14
    PUSHBUTTON      "Remove",IDC_DP_REMOVE,110,178,50,14
    PUSHBUTTON      "Open in Dired",IDC_DP_OPEN,165,178,65,14
    PUSHBUTTON      "Close",IDCANCEL,250,178,50,14
END

IDD_CLI_SETTINGS DIALOGEX 0, 0, 330, 415
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CLI Command Entries"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Entries:",IDC_STATIC,5,5,320,12
    LISTBOX         IDC_CLI_LIST,5,18,320,200,LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Command:",IDC_STATIC,5,228,45,12
