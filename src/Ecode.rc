    LTEXT           "Label:",IDC_STATIC,5,326,30,12
    EDITTEXT        IDC_CLI_LABEL,55,324,270,14,ES_AUTOHSCROLL

    PUSHBUTTON      "Add",IDC_CLI_ADD,5,350,42,14
    PUSHBUTTON      "Duplicate",IDC_CLI_DUPLICATE,52,350,48,14
    PUSHBUTTON      "Remove",IDC_CLI_REMOVE,105,350,42,14
    PUSHBUTTON      "Update",IDC_CLI_UPDATE,152,350,48,14
    PUSHBUTTON      "Run",IDC_CLI_RUN,205,350,38,14
    PUSHBUTTON      "Close",IDCANCEL,248,350,50,14
END

