    PUSHBUTTON      "...",IDC_CLI_BROWSE,280,246,20,14

    LTEXT           "Encoding:",IDC_STATIC,5,268,45,12
    COMBOBOX        IDC_CLI_ENCODING,55,266,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Shell:",IDC_STATIC,5,288,45,12
    COMBOBOX        IDC_CLI_SHELL,55,286,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Icon:",IDC_STATIC,5,306,30,12
