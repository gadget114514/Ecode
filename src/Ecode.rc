#include <windows.h>
#include "../include/resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 260, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ecode Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_TAB_SETTINGS,"SysTabControl32",WS_TABSTOP,5,5,250,200
    DEFPUSHBUTTON   "OK",IDOK,145,210,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,200,210,50,14
END

IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 240, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Font Family:",IDC_STATIC,10,10,50,8
    EDITTEXT        IDC_FONT_FAMILY,70,7,120,14,ES_AUTOHSCROLL
    LTEXT           "Font Size:",IDC_STATIC,10,30,50,8
    EDITTEXT        IDC_FONT_SIZE,70,27,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Font Weight:",IDC_STATIC,120,30,50,8
    EDITTEXT        IDC_FONT_WEIGHT,170,27,40,14,ES_AUTOHSCROLL | ES_NUMBER
    
    CHECKBOX        "Show Line Numbers",IDC_SHOW_LINE_NUMBERS,10,50,100,10
    CHECKBOX        "Enable Ligatures",IDC_ENABLE_LIGATURES,120,50,100,10
    CHECKBOX        "Enable Word Wrap",IDC_WORD_WRAP,10,65,100,10
    
    LTEXT           "Wrap Width (0 for auto):",IDC_STATIC,10,85,80,8
    EDITTEXT        IDC_WRAP_WIDTH,100,82,40,14,ES_AUTOHSCROLL | ES_NUMBER
    
    LTEXT           "Language:",IDC_STATIC,10,105,50,8
    COMBOBOX        IDC_LANGUAGE,70,102,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Caret Style:",IDC_STATIC,10,125,50,8
    COMBOBOX        IDC_CARET_STYLE,70,122,70,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "Caret Blinking",IDC_CARET_BLINKING,150,125,60,10
    
    LTEXT           "Log Level:",IDC_STATIC,10,145,50,8
    COMBOBOX        IDC_LOG_LEVEL,70,142,70,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bash Path:",IDC_STATIC,10,160,50,8
    EDITTEXT        IDC_BASH_PATH,70,157,120,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BASH_BROWSE,195,157,20,14

    LTEXT           "Text Editor Default Extension:",IDC_STATIC,10,180,110,8
    EDITTEXT        IDC_DEFAULT_EXT,120,177,80,14,ES_AUTOHSCROLL

    LTEXT           "Plugins Directory:",IDC_STATIC,10,200,70,8
    EDITTEXT        IDC_PLUGINS_DIR,80,197,110,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_PLUGINS_BROWSE,195,197,20,14

    CHECKBOX        "AI (experimental)",IDC_SHOW_AI,10,220,100,10
END

IDD_SETTINGS_AI DIALOGEX 0, 0, 240, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Active Server:",IDC_STATIC,10,10,50,8
    COMBOBOX        IDC_AI_SERVER,70,7,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    GROUPBOX        "Server Configuration",IDC_STATIC,5,30,230,120
    
    LTEXT           "Model Name:",IDC_STATIC,15,45,50,8
    EDITTEXT        IDC_AI_MODEL,75,42,120,14,ES_AUTOHSCROLL
    
    LTEXT           "API Base URL:",IDC_STATIC,15,65,50,8
    EDITTEXT        IDC_AI_BASE_URL,75,62,150,14,ES_AUTOHSCROLL
    
    LTEXT           "API Key:",IDC_STATIC,15,85,50,8
    EDITTEXT        IDC_AI_KEY,75,82,150,14,ES_PASSWORD | ES_AUTOHSCROLL
    
    LTEXT           "Allowed Project Directory:",IDC_STATIC,15,105,90,8
    EDITTEXT        IDC_AI_PROJECT_DIR,110,102,95,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_AI_PROJECT_DIR_BROWSE,210,102,20,14
    
    LTEXT           "(Note: AI can only edit files within this folder if specified)",IDC_STATIC,15,125,210,16
END

IDD_JUMP_TO_LINE DIALOGEX 0, 0, 150, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jump to Line"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Line Number:",IDC_STATIC,10,15,50,8
    EDITTEXT        IDC_LINE_NUMBER,65,12,50,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Go",IDOK,40,40,30,14
    PUSHBUTTON      "Cancel",IDCANCEL,80,40,30,14
END

IDD_MACRO_GALLERY DIALOGEX 0, 0, 200, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Macro Gallery"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_MACRO_LIST,10,10,180,110,LBS_STANDARD | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Run",IDC_RUN_MACRO,10,130,50,14
    PUSHBUTTON      "Close",IDCANCEL,140,130,50,14
END

IDD_PROGRESS DIALOGEX 0, 0, 180, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "Processing..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Please wait...",IDC_PROGRESS_TEXT,10,10,160,8
    CONTROL         "",IDC_PROGRESS_BAR,"msctls_progress32",WS_CHILD | WS_VISIBLE | 0x01,10,25,160,14
END

IDD_DIRED_PAIRS DIALOGEX 0, 0, 350, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dired Directory Pairs"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Directory Pairs:",IDC_STATIC,5,5,340,8
    LISTBOX         IDC_DP_LIST,5,15,340,80,LBS_STANDARD | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Label:",IDC_STATIC,5,105,30,8
    EDITTEXT        IDC_DP_LABEL,40,102,130,14,ES_AUTOHSCROLL

    LTEXT           "Left:",IDC_STATIC,5,125,30,8
    EDITTEXT        IDC_DP_LEFT,40,122,220,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DP_LEFT_BROWSE,265,122,20,14

    LTEXT           "Right:",IDC_STATIC,5,145,30,8
    EDITTEXT        IDC_DP_RIGHT,40,142,220,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DP_RIGHT_BROWSE,265,142,20,14

    PUSHBUTTON      "Add",IDC_DP_ADD,10,175,40,14
    PUSHBUTTON      "Duplicate",IDC_DP_DUPLICATE,55,175,50,14
    PUSHBUTTON      "Remove",IDC_DP_REMOVE,110,175,50,14
    PUSHBUTTON      "Open in Dired",IDC_DP_OPEN,165,175,65,14
    PUSHBUTTON      "Close",IDCANCEL,250,175,50,14
END

IDD_CLI_SETTINGS DIALOGEX 0, 0, 330, 265
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CLI Command Entries"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Entries:",IDC_STATIC,5,5,320,8
    LISTBOX         IDC_CLI_LIST,5,15,320,100,LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Command:",IDC_STATIC,5,125,45,8
    EDITTEXT        IDC_CLI_CMD,55,122,270,14,ES_AUTOHSCROLL

    LTEXT           "Folder:",IDC_STATIC,5,145,45,8
    EDITTEXT        IDC_CLI_FOLDER,55,142,220,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_CLI_BROWSE,280,142,20,14

    LTEXT           "Encoding:",IDC_STATIC,5,165,45,8
    COMBOBOX        IDC_CLI_ENCODING,55,163,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Shell:",IDC_STATIC,5,183,45,8
    COMBOBOX        IDC_CLI_SHELL,55,181,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Add",IDC_CLI_ADD,5,210,42,14
    PUSHBUTTON      "Duplicate",IDC_CLI_DUPLICATE,52,210,48,14
    PUSHBUTTON      "Remove",IDC_CLI_REMOVE,105,210,42,14
    PUSHBUTTON      "Update",IDC_CLI_UPDATE,152,210,48,14
    PUSHBUTTON      "Run",IDC_CLI_RUN,205,210,38,14
    PUSHBUTTON      "Close",IDCANCEL,248,210,50,14
END

IDD_PLUGIN_CONFIG DIALOGEX 0, 0, 260, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plugin Visibility"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Select plugins to hide from menu:",IDC_STATIC,10,10,240,8
    LISTBOX         IDC_PLUGIN_LIST,10,25,240,160,LBS_MULTIPLESEL | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,100,195,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,160,195,50,14
END

IDD_FIND_FILE DIALOGEX 0, 0, 250, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find File"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Pattern:",IDC_STATIC,10,10,50,8
    EDITTEXT        IDC_FIND_PATTERN,60,7,130,14,ES_AUTOHSCROLL
    LTEXT           "Directory:",IDC_STATIC,10,30,50,8
    EDITTEXT        IDC_FILE_SEARCH_DIR,60,27,130,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_FILE_SEARCH_BROWSE,195,27,20,14
    DEFPUSHBUTTON   "Search",IDOK,90,60,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,150,60,50,14
END

IDD_THEME_MANAGER DIALOGEX 0, 0, 430, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Theme Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_TH_LIST,5,5,130,210,LBS_STANDARD | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Name:",IDC_STATIC,145,8,30,8
    EDITTEXT        IDC_TH_NAME,180,5,200,14,ES_AUTOHSCROLL

    LTEXT           "Background:",IDC_STATIC,145,28,50,8
    EDITTEXT        IDC_TH_BG,200,25,70,14,ES_AUTOHSCROLL

    LTEXT           "Foreground:",IDC_STATIC,145,48,50,8
    EDITTEXT        IDC_TH_FG,200,45,70,14,ES_AUTOHSCROLL

    LTEXT           "Caret:",IDC_STATIC,145,68,50,8
    EDITTEXT        IDC_TH_CARET,200,65,70,14,ES_AUTOHSCROLL

    LTEXT           "Selection:",IDC_STATIC,145,88,50,8
    EDITTEXT        IDC_TH_SEL,200,85,70,14,ES_AUTOHSCROLL

    LTEXT           "Line Nums:",IDC_STATIC,145,108,50,8
    EDITTEXT        IDC_TH_LN,200,105,70,14,ES_AUTOHSCROLL

    LTEXT           "Keyword:",IDC_STATIC,290,28,50,8
    EDITTEXT        IDC_TH_KW,345,25,70,14,ES_AUTOHSCROLL

    LTEXT           "String:",IDC_STATIC,290,48,50,8
    EDITTEXT        IDC_TH_STR,345,45,70,14,ES_AUTOHSCROLL

    LTEXT           "Number:",IDC_STATIC,290,68,50,8
    EDITTEXT        IDC_TH_NUM,345,65,70,14,ES_AUTOHSCROLL

    LTEXT           "Comment:",IDC_STATIC,290,88,50,8
    EDITTEXT        IDC_TH_CMT,345,85,70,14,ES_AUTOHSCROLL

    LTEXT           "Function:",IDC_STATIC,290,108,50,8
    EDITTEXT        IDC_TH_FUNC,345,105,70,14,ES_AUTOHSCROLL

    PUSHBUTTON      "Add",IDC_TH_ADD,5,225,40,14
    PUSHBUTTON      "Duplicate",IDC_TH_DUPLICATE,50,225,50,14
    PUSHBUTTON      "Remove",IDC_TH_REMOVE,105,225,40,14

    PUSHBUTTON      "Apply",IDC_TH_APPLY,240,225,50,14
    PUSHBUTTON      "Close",IDCANCEL,310,225,50,14
END

IDD_FIND_IN_FILES DIALOGEX 0, 0, 250, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find in Files"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Pattern:",IDC_STATIC,10,10,50,8
    EDITTEXT        IDC_FIND_PATTERN,60,7,130,14,ES_AUTOHSCROLL
    LTEXT           "Directory:",IDC_STATIC,10,30,50,8
    EDITTEXT        IDC_FIND_DIR,60,27,130,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_FIND_BROWSE,195,27,20,14
    LTEXT           "Ext(filter):",IDC_STATIC,10,50,50,8
    EDITTEXT        IDC_FIND_EXT,60,47,130,14,ES_AUTOHSCROLL
    CHECKBOX        "Regex",IDC_FIND_REGEX,10,67,50,10
    CHECKBOX        "Match Case",IDC_FIND_MATCH_CASE,70,67,60,10
    DEFPUSHBUTTON   "Find",IDOK,90,90,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,150,90,50,14
END
