    PUSHBUTTON      "Add",IDC_TH_ADD,5,225,40,14
    PUSHBUTTON      "Duplicate",IDC_TH_DUPLICATE,50,225,50,14
    PUSHBUTTON      "Remove",IDC_TH_REMOVE,105,225,40,14

    PUSHBUTTON      "Apply",IDC_TH_APPLY,240,225,50,14
    PUSHBUTTON      "Close",IDCANCEL,310,225,50,14
