    LTEXT           "Comment:",IDC_STATIC,290,88,50,8
    EDITTEXT        IDC_TH_CMT,345,85,70,14,ES_AUTOHSCROLL

    LTEXT           "Function:",IDC_STATIC,290,108,50,8
