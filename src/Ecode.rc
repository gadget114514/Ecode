    LTEXT           "Name:",IDC_STATIC,145,8,30,8
    EDITTEXT        IDC_TH_NAME,180,5,200,14,ES_AUTOHSCROLL

    LTEXT           "Background:",IDC_STATIC,145,28,50,8
    EDITTEXT        IDC_TH_BG,200,25,70,14,ES_AUTOHSCROLL

    LTEXT           "Foreground:",IDC_STATIC,145,48,50,8
    EDITTEXT        IDC_TH_FG,200,45,70,14,ES_AUTOHSCROLL

    LTEXT           "Caret:",IDC_STATIC,145,68,50,8
    EDITTEXT        IDC_TH_CARET,200,65,70,14,ES_AUTOHSCROLL

    LTEXT           "Selection:",IDC_STATIC,145,88,50,8
    EDITTEXT        IDC_TH_SEL,200,85,70,14,ES_AUTOHSCROLL

    LTEXT           "Line Nums:",IDC_STATIC,145,108,50,8
    EDITTEXT        IDC_TH_LN,200,105,70,14,ES_AUTOHSCROLL

    LTEXT           "Keyword:",IDC_STATIC,290,28,50,8
    EDITTEXT        IDC_TH_KW,345,25,70,14,ES_AUTOHSCROLL

    LTEXT           "String:",IDC_STATIC,290,48,50,8
    EDITTEXT        IDC_TH_STR,345,45,70,14,ES_AUTOHSCROLL

    LTEXT           "Number:",IDC_STATIC,290,68,50,8
